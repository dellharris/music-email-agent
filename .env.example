# ── Anthropic ──────────────────────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Mailchimp ───────────────────────────────────────────────────────────────
# API key MUST include the datacenter suffix (e.g. abc123xyz-us6)
# Get from: Mailchimp → Account → Extras → API Keys → Create A Key
MAILCHIMP_API_KEY=your_mailchimp_api_key-us6

# Audience/List ID
# Get from: Mailchimp → Audience → Manage Audience → Settings → Audience name and defaults
MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# ── Sender info ─────────────────────────────────────────────────────────────
FROM_NAME=Your Name Here
REPLY_TO_EMAIL=you@yourdomain.com
